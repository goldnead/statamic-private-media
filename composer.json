{
    "name": "goldnead/statamic-private-media",
    "description": "Private media for Statamic: stream or hand over assets only to users who may open them, through signed links bound to the viewer, with byte ranges for video and an audit trail.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "private-media",
        "video",
        "streaming",
        "signed-urls"
    ],
    "authors": [
        {
            "name": "Adrian Goldner",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-private-media/issues",
        "source": "https://github.com/goldnead/statamic-private-media"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.40|^13.0",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "goldnead/statamic-entitlements": "^1.3",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "suggest": {
        "goldnead/statamic-entitlements": "Answers who may open a resource (1.3 or later). Without it, or another MediaAccess binding, every request is refused."
    },
    "conflict": {
        "goldnead/statamic-entitlements": "<1.3"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\PrivateMedia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\PrivateMedia\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Private Media",
            "slug": "private-media",
            "description": "Signed, viewer-bound links to private assets, with range streaming and an audit trail.",
            "url": "https://github.com/goldnead/statamic-private-media",
            "developer": "Adrian Goldner",
            "developer-url": "https://adriangoldner.dev"
        },
        "laravel": {
            "providers": [
                "Goldnead\\PrivateMedia\\ServiceProvider"
            ],
            "aliases": {
                "PrivateMedia": "Goldnead\\PrivateMedia\\Facades\\PrivateMedia"
            }
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "test:mysql": [
            "@php vendor/bin/pest -c phpunit.mysql.xml"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "fix": [
            "@php vendor/bin/pint"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true,
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
